# ==========================================
# CẤU HÌNH BOT DISCORD & KING.MC
# Copy file này thành .env và điền các giá trị
# ==========================================

# 1. Cấu hình Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here
OWNER_IDS=your_discord_id_here

# 2. Cấu hình Bot Minecraft (Mineflayer) kết nối server King.MC
MINECRAFT_ENABLED=true
MINECRAFT_HOST=kingmc.vn
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=BotKingMC
MINECRAFT_AUTH=offline
MINECRAFT_VERSION=1.20.1
# Mật khẩu nếu server KingMC dùng AuthMe (/login <pass> hoặc /register <pass> <pass>)
MINECRAFT_PASSWORD=
# ID kênh Discord nhận thông báo nạp tiền tự động (tùy chọn)
MINECRAFT_LOG_CHANNEL_ID=
# Biểu thức chính quy tùy chỉnh nhận diện tin nhắn nạp tiền trong game (tùy chọn)
# MINECRAFT_PAY_REGEX=

# 3. Cấu hình Runtime Bot
NODE_ENV=production
LOG_LEVEL=info
LOG_TO_FILE=false

# 4. Cấu hình Web Server / Healthcheck
PORT=3000
WEB_HOST=0.0.0.0
PORT_RETRY_ATTEMPTS=5

# 5. Cấu hình PostgreSQL (Tùy chọn - nếu không có DB, bot sẽ tự lưu dữ liệu bền vững qua file JSON trong thư mục data/)
POSTGRES_URL=postgresql://postgres:yourpassword@localhost:5432/titanbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=titanbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
